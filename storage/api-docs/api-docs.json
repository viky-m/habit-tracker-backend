                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/habits/{habit}/stats": {
            "get": {
                "tags": [
                    "Habit Logs"
                ],
                "summary": "Get habit statistics",
                "description": "Статистика виконання звички",
                "operationId": "e13d2946f9cce211f4eff1967a0561d3",
                "parameters": [
                    {
                        "name": "habit",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Статистика"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "Health check endpoint",
                "description": "Перевіряє статус API. Не вимагає авторизації.",
                "operationId": "14039960f5c35aafcd0adcc381fc5f34",
                "responses": {
                    "200": {
                        "description": "API працює нормально",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "timestamp": {
                                            "type": "string",
                                            "format": "date-time",
                                            "example": "2025-10-29T10:30:00.000000Z"
                                        },
                                        "version": {
                                            "type": "string",
                                            "example": "1.0.0"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Habit Tracker API is running"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
