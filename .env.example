# Docker configuration
COMPOSE_USER_ID=1000
COMPOSE_GROUP_ID=1000

# MySQL
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=habittracker
MYSQL_USER=habittracker
MYSQL_DATABASE=habittracker

# HTTP
HTTP_PORT=8081

# Mailhog
MAILER_PORT=1026
HTTP_MAILER_PORT=8026

# Xdebug
XDEBUG_REMOTE_HOST=host.docker.internal
XDEBUG_REMOTE_PORT=9003

# Laravel
APP_NAME="Habit Tracker API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=habittracker
DB_USERNAME=habittracker
DB_PASSWORD=habittracker

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@habittracker.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supported locales
SUPPORTED_LOCALES=en,uk,de,fr,es
DEFAULT_LOCALE=en
